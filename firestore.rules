rules_version = '2';

// The family code acts as the shared secret: anyone signed in (anonymously)
// who knows the code can read and edit that family's reminders.
// Nothing outside /families/{code} is readable, and families can't be listed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validCode(code) {
      return code.size() >= 10 && code.size() <= 40;
    }

    match /families/{code} {
      allow get, create, update: if signedIn() && validCode(code);

      match /reminders/{reminderId} {
        allow read, delete: if signedIn() && validCode(code);
        allow create, update: if signedIn() && validCode(code)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.dueAt is timestamp
          && request.resource.data.repeat in ['none', 'daily', 'weekly', 'monthly', 'yearly'];
      }

      match /devices/{deviceId} {
        allow read, write: if signedIn() && validCode(code);
      }
    }
  }
}
